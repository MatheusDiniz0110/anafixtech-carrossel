# Quem gera o texto: openrouter (grátis), gemini (grátis) ou claude (pago)
LLM_PROVIDER=openrouter
# openrouter.ai -> Keys. Modelos ":free" custam zero.
OPENROUTER_API_KEY=
# Lista: tenta na ordem. Veja os gratuitos em openrouter.ai/models?max_price=0
OPENROUTER_MODEL=google/gemma-4-31b-it:free,nvidia/nemotron-3-ultra-550b-a55b:free,cohere/north-mini-code:free
# Alternativa gratuita (Google AI Studio), usada se LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Só se usar claude:
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# Instagram Graph API (publica)
IG_USER_ID=
IG_ACCESS_TOKEN=
# IG_GRAPH=https://graph.instagram.com/v21.0

# URL pública onde as imagens ficam acessíveis (o Instagram baixa de lá).
# No GitHub Actions isso é montado sozinho a partir de GITHUB_REPOSITORY.
# Local: https://raw.githubusercontent.com/SEU_USUARIO/SEU_REPO/main
PUBLIC_BASE_URL=

# 0 = só publica posts que você aprovou (recomendado no começo)
# 1 = publica qualquer post sem alerta de revisão
AUTO_APPROVE=0
