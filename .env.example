# Quem gera o texto: gemini (plano gratuito) ou claude (pago)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Só se usar claude:
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# Instagram Graph API (publica)
IG_USER_ID=
IG_ACCESS_TOKEN=

# URL pública onde as imagens ficam acessíveis (o Instagram baixa de lá).
# No GitHub Actions isso é montado sozinho a partir de GITHUB_REPOSITORY.
# Local: https://raw.githubusercontent.com/SEU_USUARIO/SEU_REPO/main
PUBLIC_BASE_URL=

# 0 = só publica posts que você aprovou (recomendado no começo)
# 1 = publica qualquer post sem alerta de revisão
AUTO_APPROVE=0
